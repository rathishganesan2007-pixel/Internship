    <script>
        document.addEventListener("DOMContentLoaded", () => {
            
            // --- DOM Elements Cache Architecture ---
            const dockWrapper = document.getElementById("master-dock-element");
            const burgerTrigger = document.getElementById("dock-hamburger-trigger");
            const menuLinksVault = document.querySelector(".dock-menu-links");
            const pageSegmentViews = document.querySelectorAll(".page-segment-viewport-layer");
            const labFormRoot = document.getElementById("creative-lab-telemetry-form");
            const formFeedbackStrip = document.getElementById("form-success-relay-notification-box");
            const particleCanvas = document.getElementById("particle-matrix-canvas");

            // ==========================================================================
            // A. PERFORMANCE CANVAS MATRIX SYSTEM (High Creative Impact Background)
            // ==========================================================================
            const ctx = particleCanvas.getContext("2d");
            let particlesArray = [];
            let mouseCoordinates = { x: null, y: null, radius: 150 };

            function resizeCanvasToViewport() {
                particleCanvas.width = window.innerWidth;
                particleCanvas.height = window.innerHeight;
            }
            resizeCanvasToViewport();
            window.addEventListener("resize", resizeCanvasToViewport, { passive: true });

            window.addEventListener("mousemove", (event) => {
                mouseCoordinates.x = event.clientX;
                mouseCoordinates.y = event.clientY;
            }, { passive: true });

            window.addEventListener("mouseleave", () => {
                mouseCoordinates.x = null;
                mouseCoordinates.y = null;
            }, { passive: true });

            class Particlenode {
                constructor() {
                    this.x = Math.random() * particleCanvas.width;
                    this.y = Math.random() * particleCanvas.height;
                    this.size = Math.random() * 2 + 1;
                    this.baseX = this.x;
                    this.baseY = this.y;
                    this.density = (Math.random() * 30) + 10;
                }
                draw() {
                    ctx.fillStyle = "rgba(0, 240, 255, 0.65)";
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.closePath();
                    ctx.fill();
                }
                update() {
                    let dx = mouseCoordinates.x - this.x;
                    let dy = mouseCoordinates.y - this.y;
                    let distance = Math.sqrt(dx * dx + dy * dy);
                    let forceDirectionX = dx / distance;
                    let forceDirectionY = dy / distance;
                    let maxDistance = mouseCoordinates.radius;
                    let force = (maxDistance - distance) / maxDistance;
                    let directionX = forceDirectionX * force * this.density;
                    let directionY = forceDirectionY * force * this.density;

                    if (distance < mouseCoordinates.radius) {
                        this.x -= directionX;
                        this.y -= directionY;
                    } else {
                        if (this.x !== this.baseX) {
                            let dxBase = this.x - this.baseX;
                            this.x -= dxBase / 15;
                        }
                        if (this.y !== this.baseY) {
                            let dyBase = this.y - this.baseY;
                            this.y -= dyBase / 15;
                        }
                    }
                }
            }

            function initializeParticleGridMatrix() {
                particlesArray = [];
                const particleCount = Math.min(120, (window.innerWidth * window.innerHeight) / 9000);
                for (let i = 0; i < particleCount; i++) {
                    particlesArray.push(new Particlenode());
                }
            }
            initializeParticleGridMatrix();

            function runCanvasRenderLoopLoop() {
                ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
                for (let i = 0; i < particlesArray.length; i++) {
                    particlesArray[i].draw();
                    particlesArray[i].update();
                }
                requestAnimationFrame(runCanvasRenderLoopLoop);
            }
            runCanvasRenderLoopLoop();

            // ==========================================================================
            // B. SCROLL PERFORMANCE & FLOATING DOCK LOGIC
            // ==========================================================================
            window.addEventListener("scroll", () => {
                if (window.scrollY > 80) {
                    dockWrapper.classList.add("dock-condensed");
                } else {
                    dockWrapper.classList.remove("dock-condensed");
                }
            }, { passive: true });

            // Hamburger Drawer Mechanics
            if (burgerTrigger && menuLinksVault) {
                burgerTrigger.addEventListener("click", () => {
                    const expandedState = burgerTrigger.getAttribute("aria-expanded") === "true";
                    burgerTrigger.setAttribute("aria-expanded", !expandedState);
                    burgerTrigger.classList.toggle("active-state");
                    menuLinksVault.classList.toggle("drawer-open");
                });
            }

            // ==========================================================================
            // C. CREATIVE CLIENT-SIDE APPLICATION ROUTER PIPELINE
            // ==========================================================================
            function runActiveViewportRouteTransition(targetHashId) {
                const destinationSegment = document.querySelector(targetHashId);
                if (!destinationSegment) return;

                // Safely secure responsive layouts are collapsed prior to transition sequence loops
                if (menuLinksVault.classList.contains("drawer-open")) {
                    burgerTrigger.setAttribute("aria-expanded", "false");
                    burgerTrigger.classList.remove("active-state");
                    menuLinksVault.classList.remove("drawer-open");
                }

                // Deactivate alternative views with clean hardware compression classes
                pageSegmentViews.forEach(view => {
                    view.classList.add("view-hidden-state");
                    view.classList.remove("view-frame-activation");
                });

                // Display active destination layout block node
                destinationSegment.classList.remove("view-hidden-state");
                setTimeout(() => {
                    destinationSegment.classList.add("view-frame-activation");
                }, 30);

                // Update structural navigation classes & matching accessibility state anchors
                document.querySelectorAll(".dock-anchor").forEach(anchor => {
                    if (anchor.getAttribute("href") === targetHashId) {
                        anchor.classList.add("route-active");
                        anchor.setAttribute("aria-current", "page");
                    } else {
                        anchor.classList.remove("route-active");
                        anchor.removeAttribute("aria-current");
                    }
                });

                // Assistive technology sync relocation positioning shifts
                destinationSegment.setAttribute("tabindex", "-1");
                destinationSegment.focus();

                // Synchronize browser native navigation architecture
                if (window.location.hash !== targetHashId) {
                    window.location.hash = targetHashId;
                }
            }

            // Universal Click Event Interception Hook
            document.body.addEventListener("click", (event) => {
                const elementAnchorProxy = event.target.closest("a");
                if (elementAnchorProxy && elementAnchorProxy.getAttribute("href") && elementAnchorProxy.getAttribute("href").startsWith("#")) {
                    const destinationPayloadId = elementAnchorProxy.getAttribute("href");
                    if (destinationPayloadId !== "#master-core-app-runtime") {
                        event.preventDefault();
                        runActiveViewportRouteTransition(destinationPayloadId);
                    }
                }
            });

            // Native Popstate Engine Sync
            window.addEventListener("hashchange", () => {
                if (window.location.hash) {
                    runActiveViewportRouteTransition(window.location.hash);
                } else {
                    runActiveViewportRouteTransition("#home");
                }
            });

            // Initialize Routing Execution Evaluation
            if (window.location.hash) {
                runActiveViewportRouteTransition(window.location.hash);
            } else {
                runActiveViewportRouteTransition("#home");
            }

            // ==========================================================================
            // D. ADVANCED EXPERIENTIAL FORM PROCESSING CONTROLLER
            // ==========================================================================
            if (labFormRoot) {
                labFormRoot.addEventListener("submit", (e) => {
                    e.preventDefault();
                    const fireBtn = labFormRoot.querySelector(".form-submission-button");
                    
                    fireBtn.disabled = true;
                    fireBtn.innerText = "Encrypting Packets...";

                    setTimeout(() => {
                        formFeedbackStrip.style.display = "flex";
                        labFormRoot.reset();
                        
                        fireBtn.disabled = false;
                        fireBtn.innerText = "Fire Telemetry Envelope";
                        
                        formFeedbackStrip.scrollIntoView({ behavior: "smooth", block: "nearest" });
                    }, 1600);
                });
            }
        });
    </script>
