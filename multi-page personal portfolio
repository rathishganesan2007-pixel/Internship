        /* ==========================================================================
           11. MASTER HARDWARE VIEW TRANSITION MASKS
           ========================================================================== */
        .view-frame-activation {
            animation: viewTransitionWipe 1s var(--cubic-creative) forwards;
        }

        @keyframes viewTransitionWipe {
            from {
                opacity: 0;
                transform: translateY(60px) scale(0.98);
