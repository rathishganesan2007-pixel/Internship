    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <style>
        /* ==========================================================================
           1. CREATIVE DESIGN SYSTEM ENGINE TOKENS
           ========================================================================== */
        :root {
            --color-dark-pure: #050508;
            --color-dark-surface: #0e0f14;
            --color-dark-elevated: #161822;
            
            /* High-Contrast Electric Neon Palettes */
            --color-neon-cyan: #00f0ff;
            --color-neon-purple: #bd00ff;
            --color-neon-magenta: #ff007a;
            --color-neon-green: #39ff14;
            
            --text-ultra: #ffffff;
            --text-body: #a0a5c0;
            --text-dark-muted: #4e526e;
            
            /* Advanced Fluid Typography Engines */
            --font-display: 'Space Grotesk', sans-serif;
            --font-interface: 'Plus Jakarta Sans', sans-serif;
            
            /* Premium Fluid Micro-Timing Physics */
            --cubic-creative: cubic-bezier(0.85, 0, 0.15, 1);
            --cubic-bounce: cubic-bezier(0.68, -0.6, 0.32, 1.6);
            --transition-fluid: all 0.6s var(--cubic-creative);
            --transition-snappy: all 0.25s ease;
            
            --focus-glow: 0 0 0 3px rgba(0, 240, 255, 0.5);
        }

        /* ==========================================================================
           2. COMPREHENSIVE RECONSTRUCTIVE RESET & GLOBAL FRAMEWORK
           ========================================================================== */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: var(--color-dark-pure);
        }

        body {
            background-color: var(--color-dark-pure);
            color: var(--text-body);
            font-family: var(--font-interface);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* Ultimate WCAG 2.2 Compliant Keyboard Navigation Focus Matrix */
        *:focus-visible {
            outline: 2px dashed var(--color-neon-cyan);
            outline-offset: 6px;
            box-shadow: var(--focus-glow);
        }

        /* Hidden Accessibility Entry Framework */
        .accessibility-skip-relay {
            position: absolute;
            top: -120px;
            left: 2rem;
            background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-neon-purple));
            color: var(--color-dark-pure);
            padding: 1rem 2rem;
            border-radius: 4px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            z-index: 99999;
            text-decoration: none;
            transition: top 0.4s var(--cubic-creative);
        }

        .accessibility-skip-relay:focus {
            top: 2rem;
        }

        ul[role="list"] { list-style: none; }
        a { text-decoration: none; color: inherit; }

        /* Custom Interactive Creative Scrollbar Ecosystem */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--color-dark-pure); }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(var(--color-dark-pure), var(--color-dark-elevated), var(--color-dark-pure));
            border: 2px solid var(--color-dark-pure);
            border-radius: 100px;
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--color-neon-cyan); }

        /* ==========================================================================
           3. BACKGROUND PERFORMANCE CANVAS & AMBIENT SHADERS
           ========================================================================== */
        .interactive-fx-layer {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            pointer-events: none;
        }

        #particle-matrix-canvas {
            width: 100%;
            height: 100%;
            display: block;
            opacity: 0.45;
        }

        /* Organic Analog Film Grain Noise Overlay Scheme */
        .analog-noise-shader {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 2;
            pointer-events: none;
            opacity: 0.025;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3e%3cfilter id='noiseFilter'%3e%3cturbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3e%3c/filter%3e%3crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3e%3c/svg%3e");
        }

        /* ==========================================================================
           4. LAYOUT SYSTEM & KINETIC TYPOGRAPHY PATTERNS
           ========================================================================== */
        .master-grid-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 4rem;
            position: relative;
            z-index: 10;
        }

        .viewport-section {
            padding: 10rem 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Creative Editorial Typographic Headers */
        .kinetic-header {
            margin-bottom: 6rem;
            position: relative;
        }

        .header-index-tag {
            font-family: var(--font-display);
            font-size: 1rem;
            color: var(--color-neon-cyan);
            letter-spacing: 0.3em;
            margin-bottom: 1.5rem;
            display: block;
            text-transform: uppercase;
        }

        .header-title-mask {
            overflow: hidden;
            display: block;
        }

        .header-interactive-text {
            font-family: var(--font-display);
            font-size: clamp(3rem, 7vw, 6.5rem);
            font-weight: 700;
            line-height: 0.95;
            text-transform: uppercase;
            color: var(--text-ultra);
            letter-spacing: -0.03em;
        }

        /* ==========================================================================
           5. FIXED MASTER NAVIGATION GLASS DOCK
           ========================================================================== */
        .creative-nav-dock {
            position: fixed;
            top: 2rem;
            left: 0;
            width: 100%;
            z-index: 1000;
            transition: var(--transition-fluid);
        }

        .nav-dock-wrapper {
            max-width: 1520px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
            background: rgba(14, 15, 20, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 100px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: var(--transition-fluid);
        }

        .creative-nav-dock.dock-condensed .nav-dock-wrapper {
            max-width: 1000px;
            background: rgba(5, 5, 8, 0.85);
            border-color: rgba(0, 240, 255, 0.1);
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        }

        .dock-brand-logo {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-ultra);
            letter-spacing: -0.02em;
        }

        .dock-brand-logo span {
            color: var(--color-neon-cyan);
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
        }

        .dock-menu-links {
            display: flex;
            gap: 1rem;
        }

        .dock-anchor {
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-body);
            padding: 0.6rem 1.4rem;
            border-radius: 100px;
            transition: var(--transition-snappy);
            position: relative;
        }

        .dock-anchor:hover,
        .dock-anchor.route-active {
            color: var(--text-ultra);
            background: rgba(255, 255, 255, 0.05);
        }

        .dock-anchor::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-neon-purple));
            transition: var(--transition-fluid);
            transform: translateX(-50%);
        }

        .dock-anchor.route-active::after { width: 40%; }

        /* Adaptive Hamburger Framework Trigger */
        .dock-burger-trigger {
            display: none;
            background: transparent;
            border: none;
            cursor: pointer;
            width: 40px;
            height: 40px;
            position: relative;
        }

        .dock-burger-trigger .burger-line {
            position: absolute;
            left: 10px;
            width: 20px;
            height: 2px;
            background: var(--text-ultra);
            transition: var(--transition-snappy);
        }
        .dock-burger-trigger .line-1 { top: 15px; }
        .dock-burger-trigger .line-2 { bottom: 15px; }

        /* ==========================================================================
           6. INTERACTIVE VIEW segment 1: HERO CONCEPT ENGINE
           ========================================================================== */
        .hero-viewport-matrix {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            height: 100vh;
            padding-top: 80px;
        }

        .hero-kinetic-title-stack {
            margin-bottom: 3rem;
            position: relative;
            z-index: 5;
        }

        .hero-giant-text {
            font-family: var(--font-display);
            font-size: clamp(3.5rem, 9vw, 9rem);
            font-weight: 700;
            line-height: 0.85;
            text-transform: uppercase;
            color: var(--text-ultra);
            letter-spacing: -0.04em;
        }

        .hero-giant-text.outline-gradient {
            color: transparent;
            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.15);
            background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-neon-purple), var(--color-neon-magenta));
            -webkit-background-clip: text;
            background-size: 200% auto;
            animation: textFlowShimmer 8s linear infinite;
        }

        @keyframes textFlowShimmer {
            0% { background-position: 0% 50%; }
            100% { background-position: 200% 50%; }
        }

        .hero-editorial-sub-panel {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            gap: 4rem;
            align-items: flex-start;
        }

        .hero-abstract-paragraph {
            font-size: clamp(1.1rem, 1.8vw, 1.5rem);
            color: var(--text-body);
            font-weight: 300;
            line-height: 1.5;
            max-width: 700px;
        }

        /* High End Interactive Call-to-Action Trigger System */
        .magnetic-btn-wrapper {
            position: relative;
            display: inline-block;
        }

        .magnetic-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 180px;
            height: 180px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            color: var(--text-ultra);
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            cursor: pointer;
            position: relative;
            transition: var(--transition-fluid);
            overflow: hidden;
        }

        .btn-fluid-morph-bg {
            position: absolute;
            inset: 0;
            background: linear-gradient(45deg, var(--color-neon-purple), var(--color-neon-magenta));
            transform: scale(0) translateZ(0);
            border-radius: 50%;
            transition: transform 0.6s var(--cubic-creative);
            z-index: -1;
        }

        .magnetic-action-btn:hover {
            border-color: transparent;
            color: var(--color-dark-pure);
            box-shadow: 0 0 50px rgba(189, 0, 255, 0.4);
            transform: scale(1.05);
        }

        .magnetic-action-btn:hover .btn-fluid-morph-bg {
            transform: scale(1) translateZ(0);
            border-radius: 0;
        }

        /* ==========================================================================
           7. INTERACTIVE VIEW segment 2: ASYMMETRIC PORTFOLIO BENTO GRID
           ========================================================================== */
        .bento-showcase-matrix {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 2.5rem;
        }

        .bento-showcase-node {
            background: var(--color-dark-surface);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            transition: var(--transition-fluid);
            display: flex;
            flex-direction: column;
        }

        /* Custom Asymmetric Span Layout System */
        .bento-span-7 { grid-column: span 7; }
        .bento-span-5 { grid-column: span 5; }
        .bento-span-12 { grid-column: span 12; }

        .bento-media-container {
            width: 100%;
            height: 440px;
            overflow: hidden;
            position: relative;
            background: #020204;
        }

        .bento-media-source {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.7;
            filter: grayscale(40%);
            transition: transform 1.2s var(--cubic-creative), filter 0.6s ease;
        }

        .bento-glare-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 30%, rgba(14, 15, 20, 0.95) 100%);
            z-index: 2;
        }

        .bento-floating-tags {
            position: absolute;
            top: 2rem;
            left: 2rem;
            display: flex;
            gap: 0.75rem;
            z-index: 5;
        }

        .micro-tag-token {
            background: rgba(5, 5, 8, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 0.5rem 1.2rem;
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-ultra);
        }

        .bento-content-panel {
            padding: 3rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            position: relative;
            z-index: 3;
            background: linear-gradient(180deg, var(--color-dark-surface) 0%, var(--color-dark-pure) 100%);
        }

        .bento-node-title {
            font-family: var(--font-display);
            font-size: 2.25rem;
            color: var(--text-ultra);
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.02em;
        }

        .bento-node-summary {
            font-size: 1.1rem;
            color: var(--text-body);
            margin-bottom: 2.5rem;
            line-height: 1.6;
            max-width: 90%;
        }

        .bento-tech-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: auto;
        }

        .bento-tech-pill {
            font-size: 0.8rem;
            font-weight: 500;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 0.4rem 1rem;
            border-radius: 6px;
            color: var(--text-body);
        }

        /* High-End Structural Node Hover Reactions */
        .bento-showcase-node:hover {
            transform: translateY(-12px);
            border-color: rgba(0, 240, 255, 0.25);
            box-shadow: 0 40px 80px rgba(0,0,0,0.7), 0 0 100px rgba(0, 240, 255, 0.03);
        }

        .bento-showcase-node:hover .bento-media-source {
            transform: scale(1.06) rotate(0.5deg);
            opacity: 0.9;
            filter: grayscale(0%);
        }

        .bento-interactive-trigger {
            position: absolute;
            right: 3rem;
            bottom: 3rem;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--color-dark-elevated);
            border: 1px solid rgba(255,255,255,0.05);
            display: grid;
            place-items: center;
            color: var(--text-ultra);
            transition: var(--transition-fluid);
        }

        .bento-showcase-node:hover .bento-interactive-trigger {
            background: var(--color-neon-cyan);
            color: var(--color-dark-pure);
            transform: rotate(-45deg);
            box-shadow: 0 0 20px var(--color-neon-cyan);
        }

        /* ==========================================================================
           8. INTERACTIVE VIEW segment 3: EXPERIENTIAL CHRONOLOGY ACCORDION
           ========================================================================== */
        .experience-stack-matrix {
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }

        .experience-strip-row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 2.5rem 0;
            display: grid;
            grid-template-columns: 1.5fr 3fr 1fr;
            gap: 2rem;
            align-items: center;
            transition: var(--transition-fluid);
            position: relative;
        }

        .experience-strip-row::before {
            content: '';
            position: absolute;
            left: 0;
            bottom: -1px;
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-neon-purple));
            transition: var(--transition-fluid);
        }

        .strip-timeline {
            font-family: var(--font-display);
            font-size: 1.25rem;
            color: var(--text-dark-muted);
            font-weight: 500;
            transition: var(--transition-snappy);
        }

        .strip-core-identity h3 {
            font-family: var(--font-display);
            font-size: 2rem;
            color: var(--text-ultra);
            font-weight: 700;
        }

        .strip-core-identity .strip-brand-meta {
            font-size: 1.05rem;
            color: var(--color-neon-purple);
            font-weight: 600;
            margin-top: 0.25rem;
            display: inline-block;
        }

        .strip-narrative-panel {
            color: var(--text-body);
            font-size: 1.1rem;
            opacity: 0.8;
        }

        /* Strip Hover Interactions */
        .experience-strip-row:hover {
            padding-left: 2rem;
            padding-right: 2rem;
            background: rgba(255,255,255,0.01);
        }

        .experience-strip-row:hover::before { width: 100%; }
        .experience-strip-row:hover .strip-timeline { color: var(--color-neon-cyan); }

        /* ==========================================================================
           9. INTERACTIVE VIEW segment 4: HIGH ARCHITECTURE LAB FORM GATEWAY
           ========================================================================== */
        .contact-workspace-split {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 6rem;
            align-items: start;
        }

        .contact-editorial-billboard {
            display: flex;
            flex-direction: column;
            gap: 3rem;
        }

        .billboard-giant-callout {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3.5rem);
            line-height: 1.1;
            color: var(--text-ultra);
            font-weight: 700;
        }

        .billboard-giant-callout span {
            color: var(--color-neon-magenta);
        }

        .anchor-card-relay {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 2rem;
            background: var(--color-dark-surface);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            transition: var(--transition-fluid);
        }

        .anchor-card-relay:hover {
            background: rgba(255, 255, 255, 0.02);
            border-color: rgba(255, 0, 122, 0.3);
            transform: translateX(10px);
        }

        .relay-meta .relay-header {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-dark-muted);
            margin-bottom: 0.2rem;
        }

        .relay-meta .relay-payload {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text-ultra);
            font-family: var(--font-display);
        }

        /* High Level Form Control Blueprint Engine */
        .secure-form-hull {
            background: linear-gradient(135deg, var(--color-dark-surface) 0%, #09090d 100%);
            border: 1px solid rgba(255,255,255,0.03);
            border-radius: 32px;
            padding: 4rem;
            box-shadow: 0 40px 80px rgba(0,0,0,0.6);
            position: relative;
        }

        .form-feedback-alert-strip {
            display: none;
            align-items: center;
            gap: 1rem;
            padding: 1.5rem;
            background: rgba(57, 255, 20, 0.08);
            border: 1px solid rgba(57, 255, 20, 0.2);
            border-radius: 12px;
            color: #79ff62;
            font-weight: 500;
            margin-bottom: 3rem;
            animation: formAlertReveal 0.5s var(--cubic-creative) forwards;
        }

        @keyframes formAlertReveal {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .field-harness-group {
            position: relative;
            margin-bottom: 3rem;
        }

        .field-harness-group input,
        .field-harness-group textarea {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--text-dark-muted);
            padding: 1rem 0;
            font-family: var(--font-interface);
            font-size: 1.1rem;
            color: var(--text-ultra);
            transition: var(--transition-snappy);
        }

        .field-harness-group label {
            position: absolute;
            left: 0;
            top: 1rem;
            font-size: 1.1rem;
            color: var(--text-body);
            pointer-events: none;
            transition: var(--transition-fluid);
        }

        /* Dynamic Floated Label CSS State Patterns */
        .field-harness-group input:focus ~ label,
        .field-harness-group input:valid ~ label,
        .field-harness-group textarea:focus ~ label,
        .field-harness-group textarea:valid ~ label {
            top: -1.5rem;
            font-size: 0.85rem;
            color: var(--color-neon-cyan);
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .field-harness-group input:focus,
        .field-harness-group textarea:focus {
            outline: none;
            border-bottom-color: var(--color-neon-cyan);
        }

        .field-harness-group .field-focus-track-line {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--color-neon-cyan), var(--color-neon-purple));
            transition: var(--transition-fluid);
        }

        .field-harness-group input:focus ~ .field-focus-track-line,
        .field-harness-group textarea:focus ~ .field-focus-track-line {
            width: 100%;
        }

        .field-harness-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-submission-button {
            width: 100%;
            padding: 1.25rem;
            background: var(--text-ultra);
