<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALEX MORGAN — CREATIVE ENGINEER</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #050508; --surf: #0e0f14; --text: #a0a5c0; --bright: #fff;
            --cyan: #00f0ff; --purple: #bd00ff; --magenta: #ff007a;
            --f-disp: 'Space Grotesk', sans-serif; --f-body: 'Plus Jakarta Sans', sans-serif;
            --ease: cubic-bezier(0.85, 0, 0.15, 1); --transition: all 0.6s var(--ease);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; background: var(--bg); color: var(--text); font-family: var(--f-body); overflow-x: hidden; }
        *:focus-visible { outline: 2px dashed var(--cyan); outline-offset: 6px; }
        
        /* Master FX Layer */
        .fx { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
        #canvas { width: 100%; height: 100%; opacity: 0.45; }
        .noise { opacity: 0.025; background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3e%3cfilter id='n'%3e%3cturbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3'/%3e%3c/filter%3e%3crect width='100%25' height='100%25' filter='url(%23n)'/%3e%3c/svg%3e"); }
        
        /* Typography & Layout Shared Core */
        .container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; position: relative; z-index: 5; }
        .view { min-height: 100vh; padding: 8rem 0; display: flex; flex-direction: column; justify-content: center; }
        .v-hide { display: none !important; }
        .v-active { animation: wipe 0.8s var(--ease) forwards; }
        @keyframes wipe { from { opacity: 0; transform: translateY(40px) scale(0.98); filter: blur(8px); } to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); } }

        .k-head { margin-bottom: 4rem; text-transform: uppercase; }
        .k-head span { font-size: 0.85rem; color: var(--cyan); letter-spacing: 0.3em; display: block; margin-bottom: 1rem; }
        .k-title { font-family: var(--f-disp); font-size: clamp(2.5rem, 6vw, 5rem); color: var(--bright); line-height: 1; }

        /* Floating Space Navigation Dock */
        .dock { position: fixed; top: 1.5rem; inset-x: 0; z-index: 100; transition: var(--transition); }
        .dock-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center; height: 70px; background: rgba(14,15,20,0.4); border: 1px solid rgba(255,255,255,0.03); border-radius: 100px; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
        .dock-condensed .dock-wrap { max-width: 800px; background: rgba(5,5,8,0.9); border-color: rgba(0,240,255,0.15); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
        .logo { font-family: var(--f-disp); font-size: 1.3rem; color: var(--bright); text-decoration: none; }
        .logo span { color: var(--cyan); text-shadow: 0 0 10px var(--cyan); }
        .links { display: flex; gap: 0.5rem; list-style: none; }
        .anchor { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text); padding: 0.5rem 1.2rem; border-radius: 100px; text-decoration: none; transition: 0.25s ease; position: relative; }
        .anchor:hover, .active { color: var(--bright); background: rgba(255,255,255,0.05); }
        .active::after { content: ''; position: absolute; bottom: 0; left: 35%; width: 30%; height: 2px; background: linear-gradient(90deg, var(--cyan), var(--purple)); }

        /* Hero Frame Architecture */
        .hero-title { font-family: var(--f-disp); font-size: clamp(3.5rem, 10vw, 8rem); line-height: 0.85; color: var(--bright); font-weight: 700; margin-bottom: 3rem; }
        .shimmer { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.15); background: linear-gradient(90deg, var(--cyan), var(--purple), var(--magenta)); -webkit-background-clip: text; background-size: 200% auto; animation: flow 6s linear infinite; }
        @keyframes flow { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
        .hero-split { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
        .hero-p { font-size: clamp(1.1rem, 1.8vw, 1.4rem); font-weight: 300; line-height: 1.5; }
        .magnetic-btn { width: 140px; height: 140px; border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; color: var(--bright); font-family: var(--f-disp); font-size: 0.9rem; text-transform: uppercase; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition); text-decoration: none; justify-self: end; position: relative; overflow: hidden; z-index: 2; }
        .btn-bg { position: absolute; inset: 0; background: linear-gradient(45deg, var(--purple), var(--magenta)); transform: scale(0); border-radius: 50%; transition: transform 0.5s var(--ease); z-index: -1; }
        .magnetic-btn:hover { border-color: transparent; color: var(--bg); box-shadow: 0 0 40px rgba(189,0,255,0.4); transform: scale(1.05); }
        .magnetic-btn:hover .btn-bg { transform: scale(1); border-radius: 0; }

        /* Bento Production Layout Scheme */
        .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 2.5rem; }
        .bento-node { background: var(--surf); border: 1px solid rgba(255,255,255,0.03); border-radius: 20px; overflow: hidden; transition: var(--transition); display: flex; flex-direction: column; position: relative; }
        .b-7 { grid-column: span 7; } .b-5 { grid-column: span 5; }
        .media-box { width: 100%; height: 350px; position: relative; background: #000; overflow: hidden; }
        .media-box img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: grayscale(50%); transition: transform 1s var(--ease), filter 0.5s ease; }
        .glare { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, var(--surf) 100%); }
        .meta-box { padding: 2.5rem; display: flex; flex-direction: column; flex-grow: 1; }
        .meta-box h3 { font-family: var(--f-disp); font-size: 1.8rem; color: var(--bright); margin-bottom: 0.5rem; }
        .tech-row { display: flex; gap: 0.5rem; margin-top: auto; }
        .tech-pill { font-size: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 0.3rem 0.8rem; border-radius: 4px; }
        .bento-node:hover { transform: translateY(-8px); border-color: rgba(0, 240, 255, 0.2); box-shadow: 0 30px 60px rgba(0,0,0,0.6); }
        .bento-node:hover img { transform: scale(1.05); opacity: 0.8; filter: grayscale(0%); }

        /* Chronology Strip Framework */
        .strip { border-bottom: 1px solid rgba(255,255,255,0.05); padding: 2rem 0; display: grid; grid-template-columns: 1.5fr 3fr 2fr; gap: 2rem; align-items: center; transition: var(--transition); }
        .strip-time { font-family: var(--f-disp); font-size: 1.1rem; color: #4e526e; }
        .strip h3 { font-family: var(--f-disp); font-size: 1.6rem; color: var(--bright); }
        .strip span { color: var(--purple); font-weight: 600; font-size: 0.95rem; }
        .strip:hover { padding-left: 1.5rem; background: rgba(255,255,255,0.01); border-bottom-color: var(--cyan); }
        .strip:hover .strip-time { color: var(--cyan); }

        /* Gateway Micro-Form Ecosystem */
        .gate-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; }
        .gate-hull { background: linear-gradient(135deg, var(--surf) 0%, #09090d 100%); border: 1px solid rgba(255,255,255,0.03); border-radius: 24px; padding: 3rem; }
        .group { position: relative; margin-bottom: 2.5rem; }
        .group input, .group textarea { width: 100%; background: transparent; border: none; border-bottom: 2px solid #4e526e; padding: 0.8rem 0; font-family: var(--f-body); font-size: 1.05rem; color: var(--bright); transition: 0.3s ease; }
        .group label { position: absolute; left: 0; top: 0.8rem; pointer-events: none; transition: var(--transition); }
        .group input:focus ~ label, .group input:valid ~ label, .group textarea:focus ~ label, .group textarea:valid ~ label { top: -1.2rem; font-size: 0.8rem; color: var(--cyan); font-weight: 600; }
        .group input:focus, .group textarea:focus { outline: none; border-bottom-color: var(--cyan); }
        .gate-btn { width: 100%; padding: 1rem; background: var(--bright); border: none; border-radius: 8px; font-family: var(--f-disp); font-weight: 700; text-transform: uppercase; cursor: pointer; transition: var(--transition); }
        .gate-btn:hover { background: var(--cyan); box-shadow: 0 0 25px rgba(0,240,255,0.4); transform: translateY(-2px); }

        /* Media Queries Architecture */
        @media (max-width: 1024px) {
            .hero-split, .bento-node, .strip, .gate-layout { grid-template-columns: 1fr; gap: 2rem; }
            .b-7, .b-5 { grid-column: span 12; }
            .magnetic-btn { justify-self: start; }
        }
    </style>
</head>
<body>

    <div class="fx" aria-hidden="true"><canvas id="canvas"></canvas></div>
    <div class="fx noise" aria-hidden="true"></div>

    <header class="dock" id="dock">
        <div class="dock-wrap">
            <a href="#home" class="logo">M<span>.</span>ARCH</a>
            <nav>
                <ul class="links">
                    <li><a href="#home" class="anchor active">Index</a></li>
                    <li><a href="#projects" class="anchor">Bento</a></li>
                    <li><a href="#experience" class="anchor">Chronology</a></li>
                    <li><a href="#contact" class="anchor">Gateway</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="runtime">
        <div class="container">

            <!-- Hero Section -->
            <section id="home" class="view page-layer v-active">
                <h1 class="hero-title">DESIGN.<br><span class="shimmer">ENGINEER.</span><br>SCALE.</h1>
                <div class="hero-split">
                    <p class="hero-p">Alex Morgan is a principal interactive technologist formulating avant-garde digital products. Merging mathematical code precision with radical sensory aesthetics.</p>
                    <a href="#projects" class="magnetic-btn"><span class="btn-bg"></span>Enter Lab</a>
                </div>
            </section>

            <!-- Bento Production Grid -->
            <section id="projects" class="view page-layer v-hide">
                <div class="k-head"><span>// Index 01</span><h2 class="k-title">Selected Craft</h2></div>
                <div class="bento">
                    <article class="bento-node b-7">
                        <div class="media-box"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Data Terminal"><div class="glare"></div></div>
                        <div class="meta-box"><h3>Quantum Asset Matrix</h3><p>Real-time sub-millisecond telemetry framework tracking heavy ledger distributions securely.</p><div class="tech-row"><span class="tech-pill">TypeScript</span><span class="tech-pill">WebAssembly</span></div></div>
                    </article>
                    <article class="bento-node b-5">
                        <div class="media-box"><img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?auto=format&fit=crop&w=800&q=80" alt="Retail Layout"><div class="glare"></div></div>
                        <div class="meta-box"><h3>Aether Apparel</h3><p>Headless ultra-luxury retail ecosystem maximizing globally distributed edge networks.</p><div class="tech-row"><span class="tech-pill">NextJS</span><span class="tech-pill">GraphQL</span></div></div>
                    </article>
                </div>
            </section>

            <!-- Chronology Section -->
            <section id="experience" class="view page-layer v-hide">
                <div class="k-head"><span>// Index 02</span><h2 class="k-title">Chronology</h2></div>
                <div class="strip">
                    <div class="strip-time">2024 — PRESENT</div>
                    <div><h3>Principal UI Architect</h3><span>Nexus Systems Group</span></div>
                    <p>Defines global engineering architectural tracks, reducing execution loop rendering lags.</p>
                </div>
                <div class="strip">
                    <div class="strip-time">2022 — 2024</div>
                    <div><h3>Senior UI Specialist</h3><span>Aura Interfaces Corp</span></div>
                    <p>Engineered core asset grids processing high-density telemetry data pipelines cleanly.</p>
                </div>
            </section>

            <!-- Interactive Terminal Gateway -->
            <section id="contact" class="view page-layer v-hide">
                <div class="k-head"><span>// Index 03</span><h2 class="k-title">Lab Gateway</h2></div>
                <div class="gate-layout">
                    <p style="font-size: 2rem; color: var(--bright); line-height: 1.2;">Scaling past current performance limits? <span style="color:var(--magenta)">Sync protocols.</span></p>
                    <div class="gate-hull">
                        <form id="lab-form" onsubmit="event.preventDefault(); this.querySelector('button').innerText='Encrypting Packet...';">
                            <div class="group"><input type="text" required><label>Representative Identity</label></div>
                            <div class="group"><input type="email" required><label>Secure Connection Gateway</label></div>
                            <div class="group"><textarea required></textarea><label>Technical Parameters Outline</label></div>
                            <button type="submit" class="gate-btn">Fire Telemetry Envelope</button>
                        </form>
                    </div>
                </div>
            </section>

        </div>
    </main>

    <!-- Interactive Interactive Router Engine & High Motion Canvas Particle Array Script -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const canvas = document.getElementById("canvas"), ctx = canvas.getContext("2d");
            let pts = [], mouse = { x: null, y: null, r: 140 };

            const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
            window.addEventListener("resize", resize); resize();
            window.addEventListener("mousemove", e => { mouse.x = e.clientX; mouse.y = e.clientY; });
            window.addEventListener("mouseleave", () => { mouse.x = mouse.y = null; });

            class Particle {
                constructor() { this.x = Math.random()*canvas.width; this.y = Math.random()*canvas.height; this.bx = this.x; this.by = this.y; this.d = Math.random()*20+10; this.s = Math.random()*2+1; }
                update() {
                    let dx = mouse.x - this.x, dy = mouse.y - this.y, dist = Math.sqrt(dx*dx + dy*dy);
                    if (dist < mouse.r) {
                        let f = (mouse.r - dist) / mouse.r;
                        this.x -= (dx / dist) * f * this.d; this.y -= (dy / dist) * f * this.d;
                    } else {
                        this.x += (this.bx - this.x) * 0.08; this.y += (this.by - this.y) * 0.08;
                    }
                }
                draw() { ctx.fillStyle = "rgba(0, 240, 255, 0.6)"; ctx.beginPath(); ctx.arc(this.x, this.y, this.s, 0, Math.PI*2); ctx.fill(); }
            }

            for(let i=0; i<80; i++) pts.push(new Particle());
            function loop() { ctx.clearRect(0,0,canvas.width,canvas.height); pts.forEach(p => { p.update(); p.draw(); }); requestAnimationFrame(loop); }
            loop();

            // Client-Side Application Router Execution System Loop
            const layers = document.querySelectorAll(".page-layer"), anchors = document.querySelectorAll(".anchor");
            function route(targetId) {
                layers.forEach(l => { l.classList.add("v-hide"); l.classList.remove("v-active"); });
                const dest = document.querySelector(targetId);
                if(dest) { dest.classList.remove("v-hide"); setTimeout(() => dest.classList.add("v-active"), 20); }
                anchors.forEach(a => {
                    const match = a.getAttribute("href") === targetId;
                    a.classList.toggle("active", match);
                    if (match) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
                });
                if(window.location.hash !== targetId) window.location.hash = targetId;
            }

            document.body.addEventListener("click", e => {
                const a = e.target.closest("a");
                if (a && a.getAttribute("href")?.startsWith("#")) { e.preventDefault(); route(a.getAttribute("href")); }
            });
            window.addEventListener("scroll", () => document.getElementById("dock").classList.toggle("dock-condensed", window.scrollY > 50));
            route(window.location.hash || "#home");
        });
    </script>
</body>
</html>
