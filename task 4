<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asynchronous Weather Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
        
        .dashboard { background: #1e293b; width: 100%; max-width: 420px; padding: 2rem; border-radius: 20px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); border: 1px solid #334155; }
        h3 { margin-bottom: 1.5rem; font-size: 1.5rem; font-weight: 800; text-align: center; color: #38bdf8; }
        
        /* Search Bar Layout Component */
        .search-box { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
        input { flex: 1; padding: 0.75rem 1rem; border: 1px solid #475569; background: #0f172a; color: white; border-radius: 10px; font-size: 0.95rem; outline: none; }
        input:focus { border-color: #38bdf8; }
        button { padding: 0.75rem 1.25rem; background: #38bdf8; border: none; color: #0f172a; font-weight: 700; border-radius: 10px; cursor: pointer; font-size: 0.95rem; }
        button:hover { opacity: 0.9; }

        /* Status Panels */
        .error-msg { background: rgba(239, 68, 68, 0.15); color: #f87171; padding: 0.75rem; border-radius: 10px; font-size: 0.9rem; border: 1px solid rgba(239, 68, 68, 0.2); margin-bottom: 1rem; display: none; text-align: center; }
        .loading { text-align: center; color: #94a3b8; font-size: 0.95rem; display: none; margin: 2rem 0; }

        /* Weather UI Metrics Engine */
        .weather-info { display: none; text-align: center; animation: fadeIn 0.4s ease; }
        .city-name { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem; }
        .desc { color: #94a3b8; font-size: 0.95rem; text-transform: capitalize; margin-bottom: 1rem; }
        .temp { font-size: 3.5rem; font-weight: 800; color: white; margin-bottom: 1.5rem; }
        
        /* Local Component Alignment for Submetrics Grid */
        .metrics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; border-top: 1px solid #334155; padding-top: 1.5rem; }
        .metric-card { background: #0f172a; padding: 0.75rem; border-radius: 12px; border: 1px solid #1e293b; }
        .metric-label { font-size: 0.8rem; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; }
        .metric-value { font-size: 1.1rem; font-weight: 700; color: #f1f5f9; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <div class="dashboard">
        <h3>Live Weather Engine</h3>
        
        <div class="search-box">
            <input type="text" id="cityInput" placeholder="Enter city name (e.g., London)..." value="London">
            <button id="searchBtn">Fetch</button>
        </div>

        <div id="error" class="error-msg"></div>
        <div id="loading" class="loading">Parsing API Stream...</div>

        <div id="weatherDisplay" class="weather-info">
            <div class="city-name" id="outCity">City</div>
            <div class="desc" id="outDesc">Condition</div>
            <div class="temp" id="outTemp">--°C</div>
            
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-label">Humidity</div>
                    <div class="metric-value" id="outHumidity">--%</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Wind Velocity</div>
                    <div class="metric-value" id="outWind">-- km/h</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const cityInput = document.getElementById('cityInput');
        const searchBtn = document.getElementById('searchBtn');
        const errorDiv = document.getElementById('error');
        const loadingDiv = document.getElementById('loading');
        const displayDiv = document.getElementById('weatherDisplay');

        // Core Asynchronous Network Engine
        async function fetchWeather(city) {
            // Reset state layout components before network operations
            errorDiv.style.display = 'none';
            displayDiv.style.display = 'none';
            loadingDiv.style.display = 'block';

            const cleanCity = encodeURIComponent(city.trim());
            // wttr.in format=j1 specifies modern nested JSON output mirroring typical production API payloads
            const url = `https://wttr.in/${cleanCity}?format=j1`;

            try {
                const response = await fetch(url);

                // 1. Comprehensive Network Response Verification
                if (!response.ok) {
                    throw new Error(`Server returned HTTP state fault status: ${response.status}`);
                }

                // 2. Stream Resolution and Nested Data Parsing
                const data = await response.json();
                
                // wttr.in returns an empty fallback configuration object structure if location name strings fail internally
                if (!data.current_condition || data.current_condition.length === 0) {
                    throw new Error("Target city coordinates or name signatures could not be located.");
                }

                renderUI(data, city);

            } catch (err) {
                // 3. Central Application Graceful Error Processing Boundary
                console.error("Asynchronous pipeline failure:", err);
                errorDiv.innerText = err.message || "Failed to resolve network operations.";
                errorDiv.style.display = 'block';
            } finally {
                loadingDiv.style.display = 'none';
            }
        }

        function renderUI(data, inputCity) {
            // Target nested indices safely out of the standard raw collection structure
            const current = data.current_condition[0];
            const area = data.nearest_area[0];
            
            const cityName = area.areaName[0].value;
            const countryName = area.country[0].value;
            const temperature = current.temp_C;
            const humidity = current.humidity;
            const windSpeed = current.windspeedKmph;
            const condition = current.weatherDesc[0].value;

            // Direct assignment variables into DOM nodes
            document.getElementById('outCity').innerText = `${cityName}, ${countryName}`;
            document.getElementById('outDesc').innerText = condition;
            document.getElementById('outTemp').innerText = `${temperature}°C`;
            document.getElementById('outHumidity').innerText = `${humidity}%`;
            document.getElementById('outWind').innerText = `${windSpeed} km/h`;

            displayDiv.style.display = 'block';
        }

        // Unified Event Delegation Strategy Handlers
        searchBtn.addEventListener('click', () => {
            if (cityInput.value.trim()) fetchWeather(cityInput.value);
        });

        cityInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && cityInput.value.trim()) fetchWeather(cityInput.value);
        });

        // Initialize display configuration state immediately on viewport boot
        fetchWeather('London');
    </script>
</body>
</html>
